<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime exceptions for the PyInstaller-built API Drop app.

  - allow-unsigned-executable-memory: Python's ctypes/cffi (used by the
    `cryptography` package) create executable trampolines at runtime.
  - disable-library-validation: PyInstaller unpacks/loads bundled Python
    extension modules; keeps loading working even if a wheel ships a
    differently signed binary.

  No network, camera, microphone or file entitlements are requested.
  The app does not need the App Sandbox (Developer ID distribution).
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
